# --- Webserver ---
# 127.0.0.1 se davanti c'è cloudflared/nginx sulla stessa macchina (consigliato)
DIARIO_HOST=127.0.0.1
DIARIO_PORT=8007
# Legge l'IP reale da CF-Connecting-IP / X-Forwarded-For (solo per richieste dal loopback)
DIARIO_TRUST_PROXY=true

# --- Database ---
DIARIO_DB_PATH=data/diario.db
# Chiave per /api/export (header X-Api-Key), da dare a Oracolo. Vuota = export spento.
# Generarne una con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DIARIO_EXPORT_API_KEY=

# Segreto per firmare i cookie dei browser. Se vuoto si genera da solo in data/.segreto
# DIARIO_SEGRETO=

# --- Testi dell'interfaccia ---
# File locale con i testi da cambiare (titoli, etichette, messaggi). Contiene
# solo le chiavi da ridefinire, le altre restano quelle di
# diario/testi_predefiniti.json. Si rilegge da solo quando lo si salva.
# DIARIO_TESTI=testi.json

# --- Lunghezza dei pensieri ---
DIARIO_TESTO_MIN=3
DIARIO_TESTO_MAX=5000

# --- Limiti di invio (vedi diario/limiti.py) ---
DIARIO_ATTESA_MINIMA_S=3
DIARIO_PAUSA_BROWSER_S=30
DIARIO_MAX_ORA_BROWSER=12
DIARIO_MAX_ORA_IP=200
DIARIO_MAX_ORA_GLOBALE=600
DIARIO_ORE_DUPLICATI=24
